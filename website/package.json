{
  "name": "omnisession-website",
  "version": "0.8.57",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next dev",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node node_modules/@playwright/test/cli.js test",
    "demo:check": "vizmatic check demo/fork-session.tsx --theme dark,light --background theme --json",
    "demo:render": "vizmatic gif demo/fork-session.tsx --out public/demo --theme dark,light --scale 1 && vizmatic render demo/fork-session.tsx --out public/demo --theme dark,light --background theme --no-crop"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vizmatic": "0.1.37"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "type": "module"
}
